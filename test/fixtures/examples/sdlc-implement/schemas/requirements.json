{
  "type": "object",
  "properties": {
    "summary": {"type": "string", "maxLength": 300},
    "problem": {"type": "string", "description": "Who has what problem and what it costs, without naming the solution"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer"}, "note": {"type": "string"}}, "required": ["path", "note"], "additionalProperties": false}},
    "open_questions": {"type": "array", "maxItems": 6, "items": {"type": "object", "properties": {"question": {"type": "string"}, "recommended_default": {"type": "string"}, "why": {"type": "string"}}, "required": ["question", "recommended_default"], "additionalProperties": false}}
  },
  "required": ["summary", "problem", "acceptance_criteria", "non_goals", "evidence", "open_questions"],
  "additionalProperties": false
}
