{
  "type": "object",
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[CTSL][0-9]{1,2}$",
            "description": "Your prefix and a running number: C1 (code), T1 (test), S1 (security), L1 (lite)"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "suggestion"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "prompt_injection_detected": {
      "type": "boolean"
    }
  },
  "required": [
    "approved",
    "summary",
    "findings",
    "prompt_injection_detected"
  ],
  "additionalProperties": false
}
