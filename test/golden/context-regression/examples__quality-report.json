        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "flaky",
        "type": "tool",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "flaky",
          "type": "tool",
          "tool": "tests.list-flaky@1",
          "arguments": {
            "team": {
              "ref": "inputs.team"
            }
          },
          "project": [
