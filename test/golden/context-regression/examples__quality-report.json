        "type": "tool",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "ci_runs",
          "type": "tool",
          "tool": "ci.list-runs@1",
          "arguments": {
            "team": {
              "ref": "inputs.team"
            },
            "since": {
