          "type": "condition",
          "description": "One named pull request, or the whole repository.",
          "expression": "has(inputs.pr) && inputs.pr > 0 ? 'one' : 'all'",
          "routes": {
            "one": [
              "one_pr"
            ],
            "all": [
              "queue"
            ]
          },
          "default": "all"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "one_pr",
        "type": "tool",
        "deps": [
          "mode"
        ],
        "dataDeps": [],
        "def": {
          "id": "one_pr",
          "type": "tool",
          "description": "The pull request that was named, with its refs and whether GitHub sees conflicts.",
          "tool": "github.get-pull-request@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "number": {
              "ref": "inputs.pr"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "mode",
          "route": "one"
        }
      },
      {
        "id": "queue",
        "type": "tool",
        "deps": [
          "mode"
        ],
        "dataDeps": [],
        "def": {
          "id": "queue",
          "type": "tool",
          "description": "The open pull requests GitHub reports as conflicting (mergeable_state dirty), oldest first. Forks and, unless asked, drafts are left out.",
          "tool": "github.conflicted-prs@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "limit": {
              "cel": "has(inputs.limit) ? inputs.limit : 5"
            },
            "author": {
              "cel": "has(inputs.author) ? inputs.author : ''"
            },
            "include_drafts": {
              "cel": "has(inputs.resolve_draft) && inputs.resolve_draft"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "mode",
          "route": "all"
        }
      },
      {
        "id": "targets",
        "type": "script",
        "deps": [
          "one_pr",
