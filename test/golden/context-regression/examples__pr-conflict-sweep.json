        "def": {
          "id": "resolve_each",
          "type": "parallel",
          "description": "Resolve each conflicting pull request with the published pr-conflict-resolver (merge, rules, agent, tests, review, its own approval, then a resolution pull request). Each child waits for a person, so this may take days.",
          "for_each": {
