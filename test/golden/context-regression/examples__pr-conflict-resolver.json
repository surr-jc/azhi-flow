            "memory_mb": 512
          }
        },
        "timeoutMs": 120000,
        "maxAttempts": 3,
        "loop": {
          "loop": "attempt",
          "round": 2,
          "step": "compare"
        }
      },
      {
        "id": "attempt_2_review",
        "type": "agent",
        "deps": [
          "attempt_2_compare",
          "attempt_2_resolve",
          "pr",
          "triage"
        ],
        "dataDeps": [
          "attempt_2_compare",
          "attempt_2_resolve",
          "pr",
          "triage"
        ],
        "def": {
          "id": "attempt_2_review",
          "type": "agent",
          "description": "An independent reviewer reads the resolved merge against what each side meant (merge-intent-review skill).",
          "executor": "opencode",
          "profile": "conflict-reviewer@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "'refs/pull/' + string(inputs.pr) + '/head'"
            },
            "credential": "github-read-token",
            "depth": 1,
            "from": {
              "ref": "nodes.attempt_2_resolve.output.workspace"
            }
          },
          "input": {
            "map": "{'pr': {'repo': inputs.repo, 'number': inputs.pr, 'title': nodes.pr.output.title, 'body': nodes.pr.output.body, 'base_ref': nodes.pr.output.base_ref}, 'settled_by_rule': nodes.triage.output.resolved, 'resolver': {'summary': nodes.attempt_2_resolve.output.summary, 'resolutions': nodes.attempt_2_resolve.output.resolutions, 'unresolved': nodes.attempt_2_resolve.output.unresolved}, 'check': nodes.attempt_2_compare.output, 'diff': nodes.attempt_2_resolve.output.workspace.diff, 'diff_truncated': nodes.attempt_2_resolve.output.workspace.diff_truncated}"
          },
          "output_schema": "schemas/review.json",
          "timeout": "20m",
          "budget": {
            "max_tool_calls": 15
          }
        },
        "timeoutMs": 1200000,
        "maxAttempts": 3,
        "loop": {
          "loop": "attempt",
          "round": 2,
          "step": "review"
        },
        "agentTools": []
      },
      {
        "id": "attempt_2_refute",
        "type": "agent",
        "deps": [
          "attempt_2_resolve",
          "attempt_2_review",
          "pr"
        ],
        "dataDeps": [
          "attempt_2_resolve",
          "attempt_2_review",
          "pr"
        ],
        "def": {
          "id": "attempt_2_refute",
          "type": "agent",
          "description": "Try to refute each critical or major finding in its own checkout, on a different model, and score the confidence (finding-verification skill).",
          "executor": "opencode",
          "profile": "conflict-refuter@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "'refs/pull/' + string(inputs.pr) + '/head'"
            },
            "credential": "github-read-token",
            "depth": 1,
            "from": {
              "ref": "nodes.attempt_2_resolve.output.workspace"
            }
          },
          "input": {
            "map": "{'pr': {'repo': inputs.repo, 'number': inputs.pr, 'base_ref': nodes.pr.output.base_ref}, 'diff': nodes.attempt_2_resolve.output.workspace.diff, 'findings': nodes.attempt_2_review.output.findings.filter(f, (f.severity == 'critical' || f.severity == 'major'))}"
          },
          "output_schema": "schemas/verification.json",
          "timeout": "25m",
          "budget": {
            "max_tool_calls": 10
          }
        },
        "timeoutMs": 1500000,
        "maxAttempts": 3,
        "loop": {
          "loop": "attempt",
          "round": 2,
          "step": "refute"
        },
        "agentTools": []
      },
      {
        "id": "attempt_2_gate",
        "type": "condition",
        "deps": [
          "attempt_2_compare",
          "attempt_2_refute",
          "attempt_2_resolve",
          "attempt_2_review"
        ],
        "dataDeps": [
          "attempt_2_compare",
          "attempt_2_refute",
          "attempt_2_resolve",
          "attempt_2_review"
        ],
        "def": {
          "id": "attempt_2_gate",
          "type": "condition",
          "description": "Decides how round 2 of attempt ends.",
          "merge": "any",
          "depends_on": [
            "attempt_2_resolve",
            "attempt_2_compare",
            "attempt_2_review",
            "attempt_2_refute"
          ],
          "expression": "(nodes.attempt_2_review.output.prompt_injection_detected || nodes.attempt_2_resolve.output.prompt_injection_detected) ? 'stop' : ((nodes.attempt_2_compare.output.ok && size(nodes.attempt_2_resolve.output.unresolved) == 0 && !nodes.attempt_2_review.output.findings.exists(f, (f.severity == 'critical' || f.severity == 'major') && nodes.attempt_2_refute.output.checks.exists(c, c.id == f.id && c.verdict == 'confirmed' && c.confidence >= config.min_confidence))) ? 'done' : 'exhausted')",
          "routes": {
            "done": [],
            "stop": [],
            "no_progress": [],
            "exhausted": []
          },
          "default": "stop"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3,
        "loop": {
          "loop": "attempt",
          "round": 2,
          "step": "gate"
        }
      },
      {
        "id": "attempt",
        "type": "loop",
        "deps": [
          "attempt_1_compare",
          "attempt_1_gate",
          "attempt_1_refute",
          "attempt_1_resolve",
          "attempt_1_review",
          "attempt_2_compare",
          "attempt_2_gate",
          "attempt_2_refute",
          "attempt_2_resolve",
          "attempt_2_review"
        ],
        "dataDeps": [
          "attempt_1_compare",
          "attempt_1_refute",
          "attempt_1_resolve",
          "attempt_1_review",
          "attempt_2_compare",
          "attempt_2_refute",
          "attempt_2_resolve",
          "attempt_2_review"
        ],
        "def": {
          "id": "attempt",
          "type": "loop",
          "description": "Resolve the hunks the rules left, then check, review and try to refute the result. A rejected first attempt gets one more, on a stronger model.",
          "merge": "any",
          "depends_on": [
            "attempt_1_gate",
            "attempt_2_gate"
          ],
          "max_iterations": 2,
          "on_max": "continue",
          "reasons": {
            "stop": "An agent reported text that tried to instruct it",
            "done": "The check passed or is inconclusive, nothing is unresolved and no critical or major finding was confirmed"
          },
          "rounds": [
            {
              "gate": "attempt_1_gate",
              "required": [
                "attempt_1_resolve",
                "attempt_1_compare",
                "attempt_1_review",
                "attempt_1_refute"
              ],
              "steps": {
                "resolve": {
                  "ref": "nodes.attempt_1_resolve.output"
                },
                "compare": {
                  "ref": "nodes.attempt_1_compare.output"
                },
                "review": {
                  "ref": "nodes.attempt_1_review.output"
                },
                "refute": {
                  "ref": "nodes.attempt_1_refute.output"
                }
              }
            },
            {
              "gate": "attempt_2_gate",
              "required": [
                "attempt_2_resolve",
                "attempt_2_compare",
                "attempt_2_review",
                "attempt_2_refute"
              ],
              "steps": {
                "resolve": {
                  "ref": "nodes.attempt_2_resolve.output"
                },
                "compare": {
                  "ref": "nodes.attempt_2_compare.output"
                },
                "review": {
                  "ref": "nodes.attempt_2_review.output"
                },
                "refute": {
                  "ref": "nodes.attempt_2_refute.output"
                }
              }
            }
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "count": {
              "type": "integer"
            },
            "exited": {
              "type": "boolean"
            },
            "last": {
              "type": "object",
              "properties": {
                "resolve": {},
                "compare": {},
                "review": {},
                "refute": {}
              }
            },
            "rounds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "round": {
                    "type": "integer"
                  },
                  "outcome": {
                    "type": "string"
                  },
                  "steps": {
                    "type": "object",
                    "properties": {
                      "resolve": {},
                      "compare": {},
                      "review": {},
                      "refute": {}
                    }
                  }
                }
              }
            }
          }
        },
        "timeoutMs": 3600000,
        "maxAttempts": 3
      },
      {
        "id": "finalize",
        "type": "script",
        "deps": [
          "attempt",
          "triage"
        ],
        "dataDeps": [
          "attempt",
          "triage"
        ],
        "def": {
          "id": "finalize",
          "type": "script",
          "description": "Take the last attempt, or none if a conflict was set aside, decide whether it may ship (an open blocker stops it; a clean result is a ready pull request, any doubt makes it a draft) and write the evidence record.",
          "runtime": "python",
          "entrypoint": "scripts/finalize.py",
          "merge": "any",
          "input": {
            "map": "{'pr': nodes.triage.output.pr, 'triage': nodes.triage.output, 'min_confidence': config.min_confidence, 'attempts': has(nodes.attempt) ? nodes.attempt.output.rounds.map(r, {'resolution': r.steps.resolve, 'compare': r.steps.compare, 'review': r.steps.review, 'checks': r.steps.refute.checks}) : []}"
          },
          "output_schema": "schemas/finalize.json",
          "limits": {
            "time": "2m",
            "memory_mb": 512
          }
        },
        "timeoutMs": 120000,
        "maxAttempts": 3
      },
      {
        "id": "ship_gate",
        "type": "condition",
        "deps": [
          "finalize"
        ],
        "dataDeps": [
          "finalize"
        ],
        "def": {
          "id": "ship_gate",
          "type": "condition",
          "description": "Ask for approval only when no blocker stands; otherwise tell the pull request's author why it was not resolved.",
          "expression": "nodes.finalize.output.ship ? 'ship' : 'stop'",
          "routes": {
            "ship": [
              "release_approval"
            ],
            "stop": [
              "give_up"
            ]
          },
          "default": "stop"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "release_approval",
        "type": "approval",
        "deps": [
          "finalize",
          "pr",
          "ship_gate",
          "triage"
        ],
        "dataDeps": [
          "finalize",
          "pr",
          "triage"
        ],
        "def": {
          "id": "release_approval",
          "type": "approval",
          "description": "The release owner approves the exact resolution, its checks and its reviews before a branch is pushed.",
          "role": "admin",
          "message": {
            "cel": "'Push the resolution of ' + inputs.repo + '#' + string(inputs.pr) + ' (' + string(nodes.finalize.output.stats.files) + ' changed file(s)) to ' + nodes.finalize.output.branch + ' and open a ' + (nodes.finalize.output.draft ? 'DRAFT ' : '') + 'pull request into ' + nodes.pr.output.head_ref + '? Tests: ' + nodes.finalize.output.verdict + '. ' + nodes.finalize.output.summary + '.' + (size(nodes.finalize.output.protected) > 0 ? ' It touches protected paths.' : '')"
          },
          "payload": {
            "map": "{'comment': nodes.finalize.output.comment, 'files': nodes.finalize.output.stats, 'verdict': nodes.finalize.output.verdict, 'branch': nodes.finalize.output.branch, 'protected': nodes.finalize.output.protected, 'resolved_by_rule': nodes.triage.output.resolved, 'diff': nodes.finalize.output.diff, 'diff_truncated': nodes.finalize.output.diff_truncated}"
          },
          "expires_in": "24h",
          "on_expiry": "reject"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 86400000,
        "maxAttempts": 3,
        "route": {
          "condition": "ship_gate",
          "route": "ship"
        }
      },
      {
        "id": "push_branch",
        "type": "tool",
        "deps": [
          "finalize",
          "release_approval",
          "triage"
        ],
        "dataDeps": [
          "finalize",
          "triage"
        ],
        "def": {
          "id": "push_branch",
          "type": "tool",
          "description": "Commit the resolution as an azhi/ branch (Git Data API), a merge commit of the base branch's tip and the pull request's head. Its tree is the base plus the pull request's changes, resolved; nothing the contributor owns is touched.",
          "tool": "github.push-branch@1",
          "depends_on": [
            "release_approval"
          ],
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "branch": {
              "ref": "nodes.finalize.output.branch"
            },
            "base_sha": {
              "ref": "nodes.finalize.output.base_sha"
            },
            "merge_parent": {
              "ref": "nodes.triage.output.pr.head_sha"
            },
            "message": {
              "ref": "nodes.finalize.output.commit_message"
            },
            "files": {
              "ref": "nodes.finalize.output.files"
            }
          },
          "guard": "args.repo == inputs.repo && args.branch == nodes.finalize.output.branch && args.base_sha == nodes.triage.output.pr.base_tip && args.merge_parent == nodes.triage.output.pr.head_sha"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "open_pr",
        "type": "tool",
        "deps": [
          "finalize",
          "pr",
          "push_branch",
          "release_approval"
        ],
        "dataDeps": [
          "finalize",
          "pr",
          "push_branch",
          "release_approval"
        ],
        "def": {
          "id": "open_pr",
          "type": "tool",
          "description": "Open a pull request from that branch into the contributor's own branch (a draft when anything is in doubt), or return the one already open.",
          "tool": "github.create-pull-request@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "head": {
              "ref": "nodes.push_branch.output.branch"
            },
            "base": {
              "ref": "nodes.pr.output.head_ref"
            },
            "title": {
              "ref": "nodes.finalize.output.pr_title"
            },
            "body": {
              "cel": "nodes.finalize.output.pr_body + '\\n\\nApproved for push by ' + nodes.release_approval.output.by + '.\\n\\n_Opened by Azhi Flow (pr-conflict-resolver) after a person approved this resolution._'"
            },
            "draft": {
              "ref": "nodes.finalize.output.draft"
            }
          },
          "guard": "args.repo == inputs.repo && args.head == nodes.push_branch.output.branch && args.base == nodes.pr.output.head_ref"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "announce",
        "type": "tool",
        "deps": [
          "finalize",
          "open_pr"
        ],
        "dataDeps": [
          "finalize",
          "open_pr"
        ],
        "def": {
          "id": "announce",
          "type": "tool",
          "description": "Tell the original pull request where the resolution is.",
          "tool": "github.comment-on-pr@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "number": {
              "ref": "inputs.pr"
            },
            "body": {
              "cel": "nodes.finalize.output.comment + '\\n\\nResolution pull request: ' + nodes.open_pr.output.url"
            }
          },
          "guard": "args.repo == inputs.repo && args.number == inputs.pr"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "give_up",
        "type": "tool",
        "deps": [
          "finalize",
          "ship_gate"
        ],
        "dataDeps": [
          "finalize"
        ],
        "def": {
          "id": "give_up",
          "type": "tool",
          "description": "Post why the conflicts were not resolved automatically on the pull request, so a person can take over. Nothing is pushed.",
          "tool": "github.comment-on-pr@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "number": {
              "ref": "inputs.pr"
            },
            "body": {
              "ref": "nodes.finalize.output.comment"
            }
          },
          "guard": "args.repo == inputs.repo && args.number == inputs.pr"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "ship_gate",
          "route": "stop"
        }
      }
    ],
    "taint": {
      "untrusted": {
        "merge_attempt": "output of tainted agent merge_attempt",
        "base_run": "output of tainted agent base_run",
        "head_run": "output of tainted agent head_run",
        "triage": "output of tainted agent merge_attempt",
        "triage_gate": "output of tainted agent merge_attempt",
        "attempt_1_resolve": "output of tainted agent attempt_1_resolve",
        "attempt_1_compare": "output of tainted agent attempt_1_resolve",
        "attempt_1_review": "output of tainted agent attempt_1_review",
        "attempt_1_refute": "output of tainted agent attempt_1_refute",
        "attempt_1_gate": "output of tainted agent attempt_1_resolve",
        "attempt_2_resolve": "output of tainted agent attempt_2_resolve",
        "attempt_2_compare": "output of tainted agent attempt_2_resolve",
        "attempt_2_review": "output of tainted agent attempt_2_review",
        "attempt_2_refute": "output of tainted agent attempt_2_refute",
        "attempt_2_gate": "output of tainted agent attempt_2_resolve",
        "attempt": "output of tainted agent attempt_1_resolve",
        "finalize": "output of tainted agent attempt_1_resolve",
        "ship_gate": "output of tainted agent attempt_1_resolve",
        "push_branch": "output of tainted agent attempt_1_resolve",
        "open_pr": "output of tainted agent attempt_1_resolve",
        "announce": "output of tainted agent attempt_1_resolve",
        "give_up": "output of tainted agent attempt_1_resolve"
      },
      "tainted": {
        "merge_attempt": "reads a cloned repository (its files are untrusted)",
        "base_run": "reads a cloned repository (its files are untrusted)",
        "head_run": "reads a cloned repository (its files are untrusted)",
        "attempt_1_resolve": "reads a cloned repository (its files are untrusted)",
        "attempt_1_review": "reads a cloned repository (its files are untrusted)",
        "attempt_1_refute": "reads a cloned repository (its files are untrusted)",
        "attempt_2_resolve": "reads a cloned repository (its files are untrusted)",
        "attempt_2_review": "reads a cloned repository (its files are untrusted)",
        "attempt_2_refute": "reads a cloned repository (its files are untrusted)"
      },
      "paths": []
    }
  }
}
