          },
          "input": {
            "map": "{'pr': {'repo': inputs.repo, 'number': inputs.pr, 'title': nodes.pr.output.title, 'body': nodes.pr.output.body, 'base_ref': nodes.pr.output.base_ref}, 'settled_by_rule': nodes.triage.output.resolved, 'resolver': {'summary': nodes.resolve_2.output.summary, 'resolutions': nodes.resolve_2.output.resolutions, 'unresolved': nodes.resolve_2.output.unresolved}, 'check': nodes.compare_2.output, 'diff': nodes.resolve_2.output.workspace.diff, 'diff_truncated': nodes.resolve_2.output.workspace.diff_truncated}"
          },
          "output_schema": "schemas/review.json",
          "timeout": "20m",
          "budget": {
            "max_tool_calls": 15
          }
        },
        "timeoutMs": 1200000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "refute_2",
        "type": "agent",
        "deps": [
          "pr",
          "resolve_2",
          "review_2"
        ],
        "dataDeps": [
          "pr",
          "resolve_2",
          "review_2"
        ],
        "def": {
          "id": "refute_2",
          "type": "agent",
          "description": "Try to refute the second review's critical and major findings.",
          "executor": "opencode",
          "profile": "conflict-refuter@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "'refs/pull/' + string(inputs.pr) + '/head'"
            },
            "credential": "github-read-token",
            "depth": 1,
            "from": {
              "ref": "nodes.resolve_2.output.workspace"
            }
          },
          "input": {
            "map": "{'pr': {'repo': inputs.repo, 'number': inputs.pr, 'base_ref': nodes.pr.output.base_ref}, 'diff': nodes.resolve_2.output.workspace.diff, 'findings': nodes.review_2.output.findings.filter(f, (f.severity == 'critical' || f.severity == 'major'))}"
          },
          "output_schema": "schemas/verification.json",
          "timeout": "25m",
          "budget": {
            "max_tool_calls": 10
          }
        },
        "timeoutMs": 1500000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "finalize",
        "type": "script",
        "deps": [
          "compare_1",
          "compare_2",
          "refute_1",
          "refute_2",
          "resolve_1",
          "resolve_2",
          "review_1",
          "review_2",
          "triage"
        ],
        "dataDeps": [
          "compare_1",
          "compare_2",
          "refute_1",
          "refute_2",
          "resolve_1",
          "resolve_2",
          "review_1",
          "review_2",
          "triage"
        ],
        "def": {
          "id": "finalize",
          "type": "script",
          "description": "Take the last attempt that ran, decide whether it may ship (an open blocker stops it; a clean result is a ready pull request, any doubt makes it a draft) and write the evidence record.",
          "runtime": "python",
          "entrypoint": "scripts/finalize.py",
          "merge": "any",
          "input": {
            "map": "{'pr': nodes.triage.output.pr, 'triage': nodes.triage.output, 'min_confidence': config.min_confidence, 'attempts': [{'resolution': has(nodes.resolve_1) ? nodes.resolve_1.output : null, 'compare': has(nodes.compare_1) ? nodes.compare_1.output : null, 'review': has(nodes.review_1) ? nodes.review_1.output : null, 'checks': has(nodes.refute_1) ? nodes.refute_1.output.checks : []}, {'resolution': has(nodes.resolve_2) ? nodes.resolve_2.output : null, 'compare': has(nodes.compare_2) ? nodes.compare_2.output : null, 'review': has(nodes.review_2) ? nodes.review_2.output : null, 'checks': has(nodes.refute_2) ? nodes.refute_2.output.checks : []}]}"
          },
          "output_schema": "schemas/finalize.json",
          "limits": {
            "time": "2m",
            "memory_mb": 512
          }
        },
        "timeoutMs": 120000,
        "maxAttempts": 3
      },
      {
        "id": "ship_gate",
        "type": "condition",
        "deps": [
          "finalize"
        ],
        "dataDeps": [
          "finalize"
        ],
        "def": {
          "id": "ship_gate",
          "type": "condition",
          "description": "Ask for approval only when no blocker stands; otherwise tell the pull request's author why it was not resolved.",
          "expression": "nodes.finalize.output.ship ? 'ship' : 'stop'",
          "routes": {
            "ship": [
              "release_approval"
            ],
            "stop": [
              "give_up"
            ]
          },
          "default": "stop"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "release_approval",
        "type": "approval",
        "deps": [
          "finalize",
          "pr",
          "ship_gate",
          "triage"
        ],
        "dataDeps": [
          "finalize",
          "pr",
          "triage"
        ],
        "def": {
          "id": "release_approval",
          "type": "approval",
          "description": "The release owner approves the exact resolution, its checks and its reviews before a branch is pushed.",
          "role": "admin",
          "message": {
            "cel": "'Push the resolution of ' + inputs.repo + '#' + string(inputs.pr) + ' (' + string(nodes.finalize.output.stats.files) + ' changed file(s)) to ' + nodes.finalize.output.branch + ' and open a ' + (nodes.finalize.output.draft ? 'DRAFT ' : '') + 'pull request into ' + nodes.pr.output.head_ref + '? Tests: ' + nodes.finalize.output.verdict + '. ' + nodes.finalize.output.summary + '.' + (size(nodes.finalize.output.protected) > 0 ? ' It touches protected paths.' : '')"
          },
          "payload": {
            "map": "{'comment': nodes.finalize.output.comment, 'files': nodes.finalize.output.stats, 'verdict': nodes.finalize.output.verdict, 'branch': nodes.finalize.output.branch, 'protected': nodes.finalize.output.protected, 'resolved_by_rule': nodes.triage.output.resolved, 'diff': nodes.finalize.output.diff, 'diff_truncated': nodes.finalize.output.diff_truncated}"
          },
          "expires_in": "24h",
          "on_expiry": "reject"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 86400000,
        "maxAttempts": 3,
        "route": {
          "condition": "ship_gate",
          "route": "ship"
        }
      },
      {
        "id": "push_branch",
        "type": "tool",
        "deps": [
          "finalize",
          "release_approval",
          "triage"
        ],
        "dataDeps": [
          "finalize",
          "triage"
        ],
        "def": {
          "id": "push_branch",
          "type": "tool",
          "description": "Commit the resolution as an azhi/ branch (Git Data API), a merge commit of the base branch's tip and the pull request's head. Its tree is the base plus the pull request's changes, resolved; nothing the contributor owns is touched.",
          "tool": "github.push-branch@1",
          "depends_on": [
            "release_approval"
          ],
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "branch": {
              "ref": "nodes.finalize.output.branch"
            },
            "base_sha": {
              "ref": "nodes.finalize.output.base_sha"
            },
            "merge_parent": {
              "ref": "nodes.triage.output.pr.head_sha"
            },
            "message": {
              "ref": "nodes.finalize.output.commit_message"
            },
            "files": {
              "ref": "nodes.finalize.output.files"
            }
          },
          "guard": "args.repo == inputs.repo && args.branch == nodes.finalize.output.branch && args.base_sha == nodes.triage.output.pr.base_tip && args.merge_parent == nodes.triage.output.pr.head_sha"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "open_pr",
        "type": "tool",
        "deps": [
          "finalize",
          "pr",
          "push_branch",
          "release_approval"
        ],
        "dataDeps": [
          "finalize",
          "pr",
          "push_branch",
          "release_approval"
        ],
        "def": {
          "id": "open_pr",
          "type": "tool",
          "description": "Open a pull request from that branch into the contributor's own branch (a draft when anything is in doubt), or return the one already open.",
          "tool": "github.create-pull-request@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "head": {
              "ref": "nodes.push_branch.output.branch"
            },
            "base": {
              "ref": "nodes.pr.output.head_ref"
            },
            "title": {
              "ref": "nodes.finalize.output.pr_title"
            },
            "body": {
              "cel": "nodes.finalize.output.pr_body + '\\n\\nApproved for push by ' + nodes.release_approval.output.by + '.\\n\\n_Opened by Azhi Flow (pr-conflict-resolver) after a person approved this resolution._'"
            },
            "draft": {
              "ref": "nodes.finalize.output.draft"
            }
          },
          "guard": "args.repo == inputs.repo && args.head == nodes.push_branch.output.branch && args.base == nodes.pr.output.head_ref"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "announce",
        "type": "tool",
        "deps": [
          "finalize",
          "open_pr"
        ],
        "dataDeps": [
          "finalize",
          "open_pr"
        ],
        "def": {
          "id": "announce",
          "type": "tool",
          "description": "Tell the original pull request where the resolution is.",
          "tool": "github.comment-on-pr@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "number": {
              "ref": "inputs.pr"
            },
            "body": {
              "cel": "nodes.finalize.output.comment + '\\n\\nResolution pull request: ' + nodes.open_pr.output.url"
            }
          },
          "guard": "args.repo == inputs.repo && args.number == inputs.pr"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "give_up",
        "type": "tool",
        "deps": [
          "finalize",
          "ship_gate"
        ],
        "dataDeps": [
          "finalize"
        ],
        "def": {
          "id": "give_up",
          "type": "tool",
          "description": "Post why the conflicts were not resolved automatically on the pull request, so a person can take over. Nothing is pushed.",
          "tool": "github.comment-on-pr@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "number": {
              "ref": "inputs.pr"
            },
            "body": {
              "ref": "nodes.finalize.output.comment"
            }
          },
          "guard": "args.repo == inputs.repo && args.number == inputs.pr"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "ship_gate",
          "route": "stop"
        }
      }
    ],
    "taint": {
      "untrusted": {
        "merge_attempt": "output of tainted agent merge_attempt",
        "base_run": "output of tainted agent base_run",
        "head_run": "output of tainted agent head_run",
        "triage": "output of tainted agent merge_attempt",
        "triage_gate": "output of tainted agent merge_attempt",
        "resolve_1": "output of tainted agent resolve_1",
        "compare_1": "output of tainted agent base_run",
        "review_1": "output of tainted agent review_1",
        "refute_1": "output of tainted agent refute_1",
        "gate_1": "output of tainted agent base_run",
        "resolve_2": "output of tainted agent resolve_2",
        "compare_2": "output of tainted agent base_run",
        "review_2": "output of tainted agent review_2",
        "refute_2": "output of tainted agent refute_2",
        "finalize": "output of tainted agent base_run",
        "ship_gate": "output of tainted agent base_run",
        "push_branch": "output of tainted agent base_run",
        "open_pr": "output of tainted agent base_run",
        "announce": "output of tainted agent base_run",
        "give_up": "output of tainted agent base_run"
      },
      "tainted": {
        "merge_attempt": "reads a cloned repository (its files are untrusted)",
        "base_run": "reads a cloned repository (its files are untrusted)",
        "head_run": "reads a cloned repository (its files are untrusted)",
        "resolve_1": "reads a cloned repository (its files are untrusted)",
        "review_1": "reads a cloned repository (its files are untrusted)",
        "refute_1": "reads a cloned repository (its files are untrusted)",
        "resolve_2": "reads a cloned repository (its files are untrusted)",
        "review_2": "reads a cloned repository (its files are untrusted)",
        "refute_2": "reads a cloned repository (its files are untrusted)"
      },
      "paths": []
    }
  }
}
