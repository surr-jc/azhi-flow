{
  "ok": true,
  "diagnostics": [
    {
      "severity": "warning",
      "code": "catalog_unavailable",
      "message": "tool catalog not available: tool references, arguments and projections were not checked"
    }
  ],
  "plan": {
    "format": "azhi-plan/1",
    "compiler": "0.1.0",
    "workflowId": "ai-sdlc-factory-readiness",
    "definitionHash": "sha256:899013445db03159d504cc62107a7bbab55d6b42e456e12ffc6d5f452a470805",
    "inputsSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "title": "Tracker",
          "enum": [
            "github",
            "jira"
          ],
          "description": "Where the fix ticket is created when CI is red. The code and CI are always on GitHub."
        },
        "repo": {
          "type": "string",
          "title": "Repository",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "The GitHub repository to grade, owner/name"
        },
        "base_branch": {
          "type": "string",
          "title": "Base branch",
          "minLength": 1,
          "maxLength": 200,
          "description": "The branch the factory delivers to (for example dev); CI is judged on it"
        },
        "project": {
          "type": "string",
          "title": "Jira project",
          "maxLength": 40,
          "pattern": "^([A-Z][A-Z0-9_]+)?$",
          "description": "The Jira project key the fix ticket goes in. Needed when the tracker is Jira."
        }
      },
      "required": [
        "source",
        "repo",
        "base_branch"
      ],
      "anyOf": [
        {
          "properties": {
            "source": {
              "enum": [
                "github"
              ]
            }
          }
        },
        {
          "required": [
            "project"
          ],
          "properties": {
            "source": {
              "enum": [
                "jira"
              ]
            },
            "project": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "config": {
      "channel": "{{slack_channel}}",
      "jira_ci_jql": "{{jira_ci_jql}}",
      "ci_label": "ci-failing",
      "ready_label": "ready",
      "priority_label": "priority",
      "fix_issue_type": "Bug"
    },
    "trigger": {
      "manual": true
    },
    "nodes": [
      {
        "id": "files",
        "type": "tool",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "files",
          "type": "tool",
          "description": "Which of the standard repository files exist on the base branch.",
          "tool": "github.repo-files@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "ref": "inputs.base_branch"
            },
            "paths": [
              "README.md",
              "README",
              ".github/CODEOWNERS",
              "CODEOWNERS",
              "docs/CODEOWNERS",
              ".github/PULL_REQUEST_TEMPLATE.md",
              ".github/pull_request_template.md",
              "PULL_REQUEST_TEMPLATE.md",
              "pull_request_template.md",
              "docs/PULL_REQUEST_TEMPLATE.md",
              ".github/workflows"
            ]
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "ci",
        "type": "tool",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "ci",
          "type": "tool",
          "description": "Completed CI runs of the last 7 days, oldest first.",
          "tool": "github.ci-runs@1",
          "arguments": {
            "since": {
              "cel": "string(now - duration('168h'))"
            }
          },
          "project": [
            "id",
            "status",
            "branch",
            "started_at",
            "failed_tests"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "open_source",
        "type": "condition",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "open_source",
          "type": "condition",
          "description": "Look for an existing CI ticket in the tracker the fix would go to.",
          "expression": "inputs.source",
          "routes": {
            "github": [
              "open_github"
            ],
            "jira": [
              "open_jira"
            ]
          },
          "default": "github"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "open_github",
        "type": "tool",
        "deps": [
          "open_source"
        ],
        "dataDeps": [],
        "def": {
          "id": "open_github",
          "type": "tool",
          "description": "Open issues already labelled for a failing CI.",
          "tool": "github.factory-queue@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "label": {
              "ref": "config.ci_label"
            },
            "max_items": 10
          },
          "project": [
            "items"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "open_source",
          "route": "github"
        }
      },
      {
        "id": "open_jira",
        "type": "tool",
        "deps": [
          "open_source"
        ],
        "dataDeps": [],
        "def": {
          "id": "open_jira",
          "type": "tool",
          "description": "Open Jira issues matching the configured JQL for a failing CI (read-only).",
          "tool": "jira.search@1",
          "arguments": {
            "jql": {
              "ref": "config.jira_ci_jql"
            },
            "fields": "summary,status,labels",
            "limit": 10
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "open_source",
          "route": "jira"
        }
      },
      {
        "id": "score",
        "type": "script",
        "deps": [
          "ci",
          "files",
          "open_github",
          "open_jira",
          "open_source"
        ],
        "dataDeps": [
          "ci",
          "files",
          "open_github",
          "open_jira"
        ],
        "def": {
          "id": "score",
          "type": "script",
          "description": "The checks and the level, by rules. An existing-ticket lookup that returned nothing readable stops a fix from being proposed.",
          "runtime": "python",
          "entrypoint": "scripts/score.py",
          "merge": "any",
          "depends_on": [
            "open_source",
            "files",
            "ci"
          ],
          "input": {
            "map": "{'repo': inputs.repo, 'base_branch': inputs.base_branch, 'files': nodes.files.output, 'runs': nodes.ci.output, 'open_tickets': inputs.source == 'jira' ? (has(nodes.open_jira) && has(nodes.open_jira.output.issues) ? nodes.open_jira.output.issues : null) : (has(nodes.open_github) ? nodes.open_github.output.items : null), 'labels': [config.ci_label, config.ready_label, config.priority_label]}"
          },
          "output_schema": "schemas/score.json",
          "limits": {
            "time": "1m"
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "scorecard",
        "type": "report",
        "deps": [
          "score"
        ],
        "dataDeps": [
          "score"
        ],
        "def": {
          "id": "scorecard",
          "type": "report",
          "description": "The scorecard as Markdown.",
          "template": "templates/scorecard.md",
          "input": {
            "map": "{'s': nodes.score.output}"
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "as_of": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "markdown",
            "summary"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "scorecard_post",
        "type": "notify",
        "deps": [
          "scorecard"
        ],
        "dataDeps": [
          "scorecard"
        ],
        "def": {
          "id": "scorecard_post",
          "type": "notify",
          "description": "Post the scorecard to the channel.",
          "channel": "slack",
          "destination": {
            "ref": "config.channel"
          },
          "message": {
            "ref": "nodes.scorecard.output.markdown"
          },
          "guard": "args.channel == config.channel"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "action_id": {
              "type": "string"
            },
            "delivered": {
              "type": "boolean"
            },
            "receipt": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "needs_fix",
        "type": "condition",
        "deps": [
          "score"
        ],
        "dataDeps": [
          "score"
        ],
        "def": {
          "id": "needs_fix",
          "type": "condition",
          "description": "CI is red and nobody has filed it - ask a person. Otherwise nothing is written.",
          "expression": "nodes.score.output.propose_fix ? 'ask' : 'none'",
          "routes": {
            "ask": [
              "fix_approval"
            ],
            "none": []
          },
          "default": "none"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "fix_approval",
        "type": "approval",
        "deps": [
          "needs_fix",
          "score"
        ],
        "dataDeps": [
          "score"
        ],
        "def": {
          "id": "fix_approval",
          "type": "approval",
          "description": "A person approves the fix ticket before it is created. Answer in mission control, with azhi approve, or from the Slack approval message.",
          "role": "operator",
          "message": {
            "cel": "'CI is failing on ' + inputs.base_branch + ' in ' + inputs.repo + '. Create a fix ticket in ' + (inputs.source == 'jira' ? 'Jira project ' + inputs.project : 'GitHub') + '? The factory will pick it up first.'"
          },
          "payload": {
            "map": "{'level': nodes.score.output.level, 'failed_jobs': nodes.score.output.failed_jobs, 'ticket': nodes.score.output.ticket}"
          },
          "expires_in": "24h",
          "on_expiry": "reject"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 86400000,
        "maxAttempts": 3,
        "route": {
          "condition": "needs_fix",
          "route": "ask"
        }
      },
      {
        "id": "fix_tracker",
        "type": "condition",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "fix_tracker",
          "type": "condition",
          "description": "Create the ticket in the chosen tracker.",
          "expression": "inputs.source",
          "routes": {
            "github": [
              "create_fix_github"
            ],
            "jira": [
              "create_fix_jira"
            ]
          },
          "default": "github"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "create_fix_github",
        "type": "tool",
        "deps": [
          "fix_tracker",
          "score"
        ],
        "dataDeps": [
          "score"
        ],
        "def": {
          "id": "create_fix_github",
          "type": "tool",
          "description": "Create the fix issue, labelled so the next lap picks it up first.",
          "tool": "github.create-issue@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "title": {
              "ref": "nodes.score.output.ticket.title"
            },
            "body": {
              "ref": "nodes.score.output.ticket.body"
            },
            "labels": {
              "ref": "nodes.score.output.ticket.labels"
            }
          },
          "guard": "args.repo == inputs.repo"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "fix_tracker",
          "route": "github"
        }
      },
      {
        "id": "create_fix_jira",
        "type": "tool",
        "deps": [
          "fix_tracker",
          "score"
        ],
        "dataDeps": [
          "score"
        ],
        "def": {
          "id": "create_fix_jira",
          "type": "tool",
          "description": "Create the fix issue in the Jira project, with the same labels.",
          "tool": "jira.create-issue@1",
          "arguments": {
            "project_key": {
              "ref": "inputs.project"
            },
            "summary": {
              "ref": "nodes.score.output.ticket.title"
            },
            "issue_type": {
              "ref": "config.fix_issue_type"
            },
            "description": {
              "ref": "nodes.score.output.ticket.body"
            },
            "additional_fields": {
              "ref": "nodes.score.output.ticket.additional_fields"
            }
          },
          "guard": "args.project_key == inputs.project"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "fix_tracker",
          "route": "jira"
        }
      }
    ],
    "taint": {
      "untrusted": {},
      "tainted": {},
      "paths": []
    }
  }
}
