      },
      {
        "id": "probe",
        "type": "agent",
        "deps": [
          "pr",
          "should_probe",
          "strategy",
          "surface"
        ],
        "dataDeps": [
          "pr",
          "strategy",
          "surface"
        ],
        "def": {
          "id": "probe",
          "type": "agent",
          "description": "Write one small probe per scenario under .azhi-probes/ (no shell); after it submits the worker runs them with the trusted runner and each prints REPRODUCED or HELD.",
          "executor": "opencode",
          "profile": "prober@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "'refs/pull/' + string(inputs.pr) + '/head'"
            },
            "base_ref": {
              "cel": "has(inputs.diff_base) && inputs.diff_base != '' ? inputs.diff_base : nodes.pr.output.base_sha"
            },
            "credential": "github-read-token",
            "mode": "write",
            "test": {
              "command": "{{probe_setup_command}} && node -e \"eval(require('zlib').inflateRawSync(Buffer.from('','base64'))+'')\"",
              "timeout": "35m",
              "attempts": 1
            }
          },
          "input": {
            "map": "{'pr': nodes.pr.output, 'review_from': has(inputs.diff_base) ? inputs.diff_base : '', 'strategy': nodes.strategy.output, 'scenarios': nodes.surface.output.scenarios}"
          },
          "output_schema": "schemas/probes.json",
          "timeout": "60m",
          "budget": {
            "max_tool_calls": 30
          }
        },
        "timeoutMs": 3600000,
        "maxAttempts": 3,
        "route": {
          "condition": "should_probe",
          "route": "probe"
        },
        "agentTools": []
      },
      {
        "id": "probe_results",
        "type": "script",
        "deps": [
          "probe",
          "should_probe",
          "surface"
        ],
        "dataDeps": [
          "probe",
          "surface"
        ],
        "def": {
          "id": "probe_results",
          "type": "script",
          "description": "One result per scenario from what the runner printed - reproduced, ruled out or unproven; a change outside .azhi-probes/ voids the probes (plain rules, no model).",
          "runtime": "python",
          "entrypoint": "scripts/probe_results.py",
          "merge": "any",
          "depends_on": [
            "should_probe"
          ],
          "input": {
            "map": "{'surface': nodes.surface.output, 'probe': has(nodes.probe) ? nodes.probe.output : {}}"
          },
          "output_schema": "schemas/probe_results.json",
          "limits": {
            "time": "2m",
            "memory_mb": 512
          }
        },
        "timeoutMs": 120000,
        "maxAttempts": 3
      },
      {
        "id": "verify",
        "type": "agent",
        "deps": [
          "conformance",
          "pr",
          "probe_results",
          "requirements",
          "static"
        ],
        "dataDeps": [
          "conformance",
          "pr",
          "probe_results",
          "requirements",
          "static"
        ],
        "def": {
          "id": "verify",
          "type": "agent",
          "description": "Try to refute every finding and every reproduced failure in a fresh checkout and score the confidence (finding-verification skill, a different model).",
          "executor": "opencode",
          "profile": "finding-refuter@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "'refs/pull/' + string(inputs.pr) + '/head'"
            },
            "base_ref": {
              "cel": "has(inputs.diff_base) && inputs.diff_base != '' ? inputs.diff_base : nodes.pr.output.base_sha"
            },
            "credential": "github-read-token"
          },
          "input": {
            "map": "{'pr': nodes.pr.output, 'review_from': has(inputs.diff_base) ? inputs.diff_base : '', 'criteria': nodes.requirements.output.criteria, 'findings': nodes.static.output.findings + nodes.conformance.output.findings + nodes.probe_results.output.findings}"
          },
          "output_schema": "schemas/verification.json",
          "timeout": "30m",
          "budget": {
            "max_tool_calls": 15
          }
        },
        "timeoutMs": 1800000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "triage",
        "type": "script",
        "deps": [
          "conformance",
          "probe_results",
          "requirements",
          "static",
          "strategy",
          "surface",
          "ticket",
          "verify"
        ],
        "dataDeps": [
          "conformance",
          "probe_results",
          "requirements",
          "static",
          "strategy",
          "surface",
          "ticket",
          "verify"
        ],
        "def": {
          "id": "triage",
          "type": "script",
          "description": "Decide the verdict (breaks, unproven, holds), the severities, the requirement coverage and the light from the evidence (plain rules, no model).",
          "runtime": "python",
          "entrypoint": "scripts/triage.py",
          "input": {
            "map": "{'origin': nodes.ticket.output.origin, 'requirements': nodes.requirements.output, 'conformance': nodes.conformance.output, 'reviews': [nodes.static.output], 'probes': nodes.probe_results.output, 'surface': nodes.surface.output, 'strategy': nodes.strategy.output, 'checks': nodes.verify.output.checks, 'min_confidence': config.min_confidence}"
          },
          "output_schema": "schemas/triage.json",
          "limits": {
            "time": "2m",
            "memory_mb": 512
          }
        },
        "timeoutMs": 120000,
        "maxAttempts": 3
      },
      {
        "id": "summarize",
        "type": "agent",
        "deps": [
          "pr",
          "requirements",
          "ticket",
          "triage"
        ],
        "dataDeps": [
          "pr",
          "requirements",
          "ticket",
          "triage"
        ],
        "def": {
          "id": "summarize",
          "type": "agent",
          "description": "Write the plain summary and the author's next steps from the decided facts; it cannot change them.",
          "executor": "opencode",
          "profile": "review-summarizer@1",
          "input": {
            "map": "{'pr': {'repo': nodes.pr.output.repo, 'number': nodes.pr.output.number, 'title': nodes.pr.output.title}, 'requirement': {'origin': nodes.ticket.output.origin, 'title': nodes.ticket.output.title, 'summary': nodes.requirements.output.summary}, 'facts': nodes.triage.output}"
          },
          "output_schema": "schemas/review.json",
          "timeout": "10m",
          "budget": {
            "max_tool_calls": 2
          }
        },
        "timeoutMs": 600000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "review",
        "type": "report",
        "deps": [
          "fingerprint",
          "pr",
          "probe_results",
          "requirements",
          "summarize",
          "ticket",
          "triage"
        ],
        "dataDeps": [
          "fingerprint",
          "pr",
          "probe_results",
          "requirements",
          "summarize",
          "ticket",
          "triage"
        ],
        "def": {
          "id": "review",
          "type": "report",
          "description": "The review as a run artifact and as the PR comment (a template over the decided facts; no model writes the verdict).",
          "template": "templates/review.md",
          "input": {
            "map": "{'pr': nodes.pr.output, 'ticket': {'title': nodes.ticket.output.shown_title, 'url': nodes.ticket.output.url}, 'ambiguous': nodes.requirements.output.ambiguous, 'review': nodes.summarize.output, 't': nodes.triage.output, 'fingerprint': nodes.fingerprint.output.value, 'view': {'icon': nodes.triage.output.light == 'red' ? '🔴' : (nodes.triage.output.light == 'yellow' ? '🟡' : '🟢'), 'headline': nodes.triage.output.recommendation == 'request_changes' ? 'No-go, changes requested' : (nodes.triage.output.recommendation == 'comment' ? 'Caution' : 'Go'), 'verdict_word': nodes.triage.output.verdict == 'breaks' ? 'Breaks' : (nodes.triage.output.verdict == 'unproven' ? 'Unproven' : 'Holds'), 'origin_label': nodes.ticket.output.source == 'jira' ? 'Jira ticket' : (nodes.ticket.output.source == 'github' ? 'GitHub issue' : (nodes.ticket.output.source == 'text' ? 'typed requirement' : 'inferred from the PR description')), 'dirty': size(nodes.probe_results.output.dirty_paths) > 0, 'dirty_count': size(nodes.probe_results.output.dirty_paths)}}"
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "as_of": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "markdown",
            "summary"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "slack_message",
        "type": "report",
        "deps": [
          "pr",
          "summarize",
          "triage"
        ],
        "dataDeps": [
          "pr",
          "summarize",
          "triage"
        ],
        "def": {
          "id": "slack_message",
          "type": "report",
          "description": "The short Slack message: verdict, summary and the findings.",
          "template": "templates/slack.md",
          "input": {
            "map": "{'pr': nodes.pr.output, 'review': nodes.summarize.output, 't': nodes.triage.output, 'view': {'icon': nodes.triage.output.light == 'red' ? '🔴' : (nodes.triage.output.light == 'yellow' ? '🟡' : '🟢'), 'headline': nodes.triage.output.recommendation == 'request_changes' ? 'No-go, changes requested' : (nodes.triage.output.recommendation == 'comment' ? 'Caution' : 'Go'), 'verdict_word': nodes.triage.output.verdict == 'breaks' ? 'Breaks' : (nodes.triage.output.verdict == 'unproven' ? 'Unproven' : 'Holds')}}"
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "as_of": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "markdown",
            "summary"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "should_post",
        "type": "condition",
        "deps": [
          "review"
        ],
        "dataDeps": [],
        "def": {
          "id": "should_post",
          "type": "condition",
          "description": "Post the review unless this is a dry run (post set to false).",
          "expression": "has(inputs.post) && !inputs.post ? 'skip' : 'post'",
          "depends_on": [
            "review"
          ],
          "routes": {
            "post": [
              "post"
            ],
            "skip": []
          },
          "default": "post"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "should_notify",
        "type": "condition",
        "deps": [
          "slack_message",
          "triage"
        ],
        "dataDeps": [
          "triage"
        ],
        "def": {
          "id": "should_notify",
          "type": "condition",
          "description": "Tell Slack when there is something to act on (the light is not green), only when posting and a channel is set.",
          "expression": "has(inputs.post) && !inputs.post ? 'skip' : (config.channel != '' && !config.channel.startsWith('{{') && nodes.triage.output.light != 'green' ? 'notify' : 'skip')",
          "depends_on": [
            "slack_message"
          ],
          "routes": {
            "notify": [
              "notify"
            ],
            "skip": []
          },
          "default": "skip"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "post",
        "type": "tool",
        "deps": [
          "review",
          "should_post"
        ],
        "dataDeps": [
          "review"
        ],
        "def": {
          "id": "post",
          "type": "tool",
          "description": "Post the review as a comment on the pull request, or edit the review comment an earlier run posted there.",
          "tool": "github.comment-on-pr@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "number": {
              "ref": "inputs.pr"
            },
            "body": {
              "ref": "nodes.review.output.markdown"
            }
          },
          "guard": "args.repo == inputs.repo && args.number == inputs.pr"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "should_post",
          "route": "post"
        }
      },
      {
        "id": "notify",
        "type": "notify",
        "deps": [
          "should_notify",
          "slack_message"
        ],
        "dataDeps": [
          "slack_message"
        ],
        "def": {
          "id": "notify",
          "type": "notify",
          "description": "Slack message with the verdict and the findings.",
          "channel": "slack",
          "destination": {
            "ref": "config.channel"
          },
          "message": {
            "ref": "nodes.slack_message.output.markdown"
          },
          "guard": "args.channel == config.channel"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "action_id": {
              "type": "string"
            },
            "delivered": {
              "type": "boolean"
            },
            "receipt": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "should_notify",
          "route": "notify"
        }
      }
    ],
    "taint": {
      "untrusted": {
        "conformance": "output of tainted agent conformance",
        "static": "output of tainted agent static",
        "strategy": "output of tainted agent strategy",
        "surface": "output of tainted agent surface",
        "should_probe": "output of tainted agent surface",
        "probe": "output of tainted agent probe",
        "probe_results": "output of tainted agent probe",
        "verify": "output of tainted agent verify",
        "triage": "output of tainted agent conformance",
        "summarize": "output of tainted agent summarize",
        "review": "output of tainted agent probe",
        "slack_message": "output of tainted agent summarize",
        "should_notify": "output of tainted agent conformance",
        "post": "output of tainted agent probe",
        "notify": "output of tainted agent summarize"
      },
      "tainted": {
        "conformance": "reads a cloned repository (its files are untrusted)",
        "static": "reads a cloned repository (its files are untrusted)",
        "strategy": "reads a cloned repository (its files are untrusted)",
        "surface": "reads a cloned repository (its files are untrusted)",
        "probe": "reads a cloned repository (its files are untrusted)",
        "verify": "reads a cloned repository (its files are untrusted)",
        "summarize": "reads triage, whose output of tainted agent conformance"
      },
      "paths": [
        {
          "agent": "conformance",
          "write": "notify",
          "path": [
            "conformance",
            "triage",
            "slack_message",
            "notify"
          ],
          "gate": "guard"
        },
        {
          "agent": "static",
          "write": "notify",
          "path": [
            "static",
            "triage",
            "slack_message",
            "notify"
          ],
          "gate": "guard"
        },
        {
          "agent": "strategy",
          "write": "notify",
          "path": [
            "strategy",
            "triage",
            "slack_message",
            "notify"
          ],
          "gate": "guard"
        },
        {
          "agent": "surface",
          "write": "notify",
          "path": [
            "surface",
            "triage",
            "slack_message",
            "notify"
          ],
          "gate": "guard"
        },
        {
          "agent": "probe",
          "write": "notify",
          "path": [
            "probe",
            "probe_results",
            "triage",
            "slack_message",
            "notify"
          ],
          "gate": "guard"
        },
        {
          "agent": "verify",
          "write": "notify",
          "path": [
            "verify",
            "triage",
            "slack_message",
            "notify"
          ],
          "gate": "guard"
        },
        {
          "agent": "summarize",
          "write": "notify",
          "path": [
            "summarize",
            "slack_message",
            "notify"
          ],
          "gate": "guard"
        }
      ]
    }
  }
}
