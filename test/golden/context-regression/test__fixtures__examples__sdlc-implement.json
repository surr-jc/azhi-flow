    "inputsSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "title": "Source",
          "enum": [
            "jira",
            "github"
          ],
          "description": "Where the ticket lives"
        },
        "ticket": {
          "type": "string",
          "title": "Ticket",
          "maxLength": 300,
          "description": "A Jira key such as PAY-142, or a GitHub issue such as acme/payments#42"
        },
        "repo": {
          "type": "string",
          "title": "Repository",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "The repository to change, owner/name"
        },
        "base_branch": {
          "type": "string",
          "title": "Base branch",
          "maxLength": 200,
          "description": "Branch to build on and open the pull request against; leave empty for the default branch"
        }
      },
      "required": [
        "source",
        "ticket",
        "repo"
      ]
    },
    "config": {
      "channel": "{{slack_channel}}",
      "test_command": "{{test_command}}"
    },
    "trigger": {
      "manual": true
    },
    "nodes": [
      {
        "id": "source",
        "type": "condition",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "source",
          "type": "condition",
          "description": "Read the ticket from Jira or from GitHub.",
          "expression": "inputs.source",
          "routes": {
            "jira": [
              "jira_issue"
            ],
            "github": [
              "github_issue"
            ]
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "jira_issue",
        "type": "tool",
        "deps": [
          "source"
        ],
        "dataDeps": [],
        "def": {
          "id": "jira_issue",
          "type": "tool",
          "description": "Read the Jira ticket through the Jira MCP server.",
          "tool": "jira.get-issue@1",
          "arguments": {
            "issue_key": {
              "ref": "inputs.ticket"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "source",
          "route": "jira"
        }
      },
      {
        "id": "github_issue",
        "type": "tool",
        "deps": [
          "source"
        ],
        "dataDeps": [],
        "def": {
          "id": "github_issue",
          "type": "tool",
          "description": "Read the GitHub issue and its first comments.",
          "tool": "github.get-issue@1",
          "arguments": {
            "issue": {
              "ref": "inputs.ticket"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "source",
          "route": "github"
        }
      },
      {
        "id": "intake",
        "type": "tool",
        "deps": [
          "github_issue",
          "jira_issue"
        ],
        "dataDeps": [
          "github_issue",
          "jira_issue"
        ],
        "def": {
          "id": "intake",
          "type": "tool",
          "description": "Turn the Jira ticket or GitHub issue into one plain ticket (key, title, description, priority, reporter).",
          "tool": "ticket.normalize@1",
          "merge": "any",
          "arguments": {
            "source": {
              "ref": "inputs.source"
            },
            "issue": {
              "cel": "inputs.source == 'jira' ? nodes.jira_issue.output : nodes.github_issue.output"
            }
          },
          "project": [
            "source",
            "key",
            "title",
            "description",
            "priority",
            "reporter",
            "status",
            "labels",
            "url"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "requirements",
        "type": "agent",
        "deps": [
          "intake"
        ],
        "dataDeps": [
          "intake"
        ],
        "def": {
          "id": "requirements",
          "type": "agent",
          "description": "Turn the ticket into testable requirements grounded in the code (requirements-brief skill).",
          "executor": "opencode",
          "profile": "product-analyst@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "has(inputs.base_branch) && inputs.base_branch != '' ? 'refs/heads/' + inputs.base_branch : 'HEAD'"
            },
            "credential": "github-read-token",
            "depth": 1
          },
          "input": {
            "map": "{'ticket': nodes.intake.output, 'repository': inputs.repo}"
          },
          "output_schema": "schemas/requirements.json",
          "timeout": "20m",
          "budget": {
            "max_tool_calls": 10
          }
        },
        "timeoutMs": 1200000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "design",
        "type": "agent",
        "deps": [
          "intake",
          "requirements"
        ],
        "dataDeps": [
          "intake",
          "requirements"
        ],
        "def": {
          "id": "design",
          "type": "agent",
          "description": "Weigh the approaches and plan the change file by file (implementation-plan skill).",
          "executor": "opencode",
          "profile": "architect@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "has(inputs.base_branch) && inputs.base_branch != '' ? 'refs/heads/' + inputs.base_branch : 'HEAD'"
            },
            "credential": "github-read-token",
            "depth": 1
          },
          "input": {
            "map": "{'ticket': nodes.intake.output, 'requirements': nodes.requirements.output}"
          },
          "output_schema": "schemas/design.json",
          "timeout": "25m",
          "budget": {
            "max_tool_calls": 10
          }
        },
        "timeoutMs": 1500000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "design_review",
        "type": "approval",
        "deps": [
          "design",
          "intake",
          "requirements"
        ],
        "dataDeps": [
          "design",
          "intake",
          "requirements"
        ],
        "def": {
          "id": "design_review",
          "type": "approval",
          "description": "A senior engineer approves the design and answers its open questions before any code is written.",
          "role": "author",
          "message": {
            "cel": "'Approve the design for ' + nodes.intake.output.key + ': ' + nodes.design.output.summary + '? Answer the ' + string(size(nodes.requirements.output.open_questions) + size(nodes.design.output.open_questions)) + ' open question(s) first.'"
          },
          "payload": {
            "map": "{'open_questions': nodes.requirements.output.open_questions + nodes.design.output.open_questions, 'requirements': nodes.requirements.output, 'design': nodes.design.output}"
          },
          "decision_schema": {
            "type": "object",
            "properties": {
              "answers": {
                "type": "string",
                "minLength": 1,
                "title": "Answers to the open questions",
                "description": "One answer per open question, or: use the recommended defaults"
              },
              "notes": {
                "type": "string",
                "title": "Notes for the engineer"
              }
            },
            "required": [
              "answers"
            ],
            "additionalProperties": false
          },
          "expires_in": "72h",
          "on_expiry": "reject"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 259200000,
        "maxAttempts": 3
      },
      {
        "id": "build",
        "type": "agent",
        "deps": [
          "design",
          "design_review",
          "intake",
          "requirements"
        ],
        "dataDeps": [
          "design",
          "design_review",
          "intake",
          "requirements"
        ],
        "def": {
          "id": "build",
          "type": "agent",
          "description": "Implement the approved plan in the checkout; the worker then runs the tests (implement-change skill).",
          "executor": "opencode",
          "profile": "engineer@1",
          "depends_on": [
            "design_review"
          ],
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "has(inputs.base_branch) && inputs.base_branch != '' ? 'refs/heads/' + inputs.base_branch : 'HEAD'"
            },
            "credential": "github-read-token",
            "depth": 1,
            "mode": "write",
            "test": {
              "command": "{{test_command}}",
              "timeout": "15m",
              "attempts": 3
            }
          },
          "input": {
            "map": "{'ticket': nodes.intake.output, 'requirements': nodes.requirements.output, 'design': nodes.design.output, 'decisions': nodes.design_review.output.data}"
          },
          "output_schema": "schemas/change.json",
          "timeout": "60m",
          "budget": {
            "max_tool_calls": 10
          }
        },
        "timeoutMs": 3600000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "code_review",
        "type": "agent",
        "deps": [
          "build",
          "design",
          "requirements"
        ],
        "dataDeps": [
          "build",
          "design",
          "requirements"
        ],
        "def": {
          "id": "code_review",
          "type": "agent",
          "description": "Review the diff against the requirements, the design and the base code (fresh-eyes-review skill).",
          "executor": "opencode",
          "profile": "reviewer@1",
          "workspace": {
            "repo": {
              "ref": "inputs.repo"
            },
            "ref": {
              "cel": "has(inputs.base_branch) && inputs.base_branch != '' ? 'refs/heads/' + inputs.base_branch : 'HEAD'"
            },
            "credential": "github-read-token",
            "depth": 1
          },
          "input": {
            "map": "{'requirements': nodes.requirements.output, 'design': nodes.design.output, 'change': {'summary': nodes.build.output.summary, 'deviations': nodes.build.output.deviations, 'tests_added': nodes.build.output.tests_added, 'stats': nodes.build.output.workspace.stats, 'diff': nodes.build.output.workspace.diff, 'diff_truncated': nodes.build.output.workspace.diff_truncated, 'tests': nodes.build.output.workspace.tests}}"
          },
          "output_schema": "schemas/review.json",
          "timeout": "20m",
          "budget": {
            "max_tool_calls": 10
          }
        },
        "timeoutMs": 1200000,
        "maxAttempts": 3,
        "agentTools": []
      },
      {
        "id": "quality_gate",
        "type": "condition",
        "deps": [
          "build",
          "code_review"
        ],
        "dataDeps": [
          "build",
          "code_review"
        ],
        "def": {
          "id": "quality_gate",
          "type": "condition",
          "description": "Ship only when the tests passed, the review approves and there is a change.",
          "expression": "nodes.build.output.workspace.tests.status == 'passed' && nodes.code_review.output.approved && size(nodes.build.output.workspace.files) > 0 ? 'ship' : 'fix'",
          "routes": {
            "ship": [
              "release_approval"
            ],
            "fix": [
              "send_back"
            ]
          },
          "default": "fix"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "release_approval",
        "type": "approval",
        "deps": [
          "build",
          "code_review",
          "intake",
          "quality_gate"
        ],
        "dataDeps": [
          "build",
          "code_review",
          "intake"
        ],
        "def": {
          "id": "release_approval",
          "type": "approval",
          "description": "The release owner approves the exact change before a branch is pushed and a pull request opened.",
          "role": "admin",
          "message": {
            "cel": "'Push ' + string(nodes.build.output.workspace.stats.files) + ' changed file(s) for ' + nodes.intake.output.key + ' to ' + inputs.repo + ' and open a pull request? Tests ' + nodes.build.output.workspace.tests.status + '.'"
          },
          "payload": {
            "map": "{'repository': inputs.repo, 'branch': 'azhi/' + nodes.intake.output.key, 'pr_title': nodes.build.output.pr_title, 'stats': nodes.build.output.workspace.stats, 'diff': nodes.build.output.workspace.diff, 'tests': nodes.build.output.workspace.tests, 'review': nodes.code_review.output}"
          },
          "expires_in": "24h",
          "on_expiry": "reject"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 86400000,
        "maxAttempts": 3,
        "route": {
          "condition": "quality_gate",
          "route": "ship"
        }
      },
      {
        "id": "push_branch",
        "type": "tool",
        "deps": [
          "build",
          "intake",
          "release_approval"
        ],
        "dataDeps": [
          "build",
          "intake"
        ],
        "def": {
          "id": "push_branch",
          "type": "tool",
          "description": "Commit the change onto the base commit and push it as an azhi/ branch (Git Data API).",
          "tool": "github.push-branch@1",
          "depends_on": [
            "release_approval"
          ],
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "branch": {
              "cel": "'azhi/' + nodes.intake.output.key"
            },
            "base_sha": {
              "ref": "nodes.build.output.workspace.base_sha"
            },
            "message": {
              "cel": "nodes.build.output.commit_message + '\\n\\nRefs: ' + nodes.intake.output.key"
            },
            "files": {
              "ref": "nodes.build.output.workspace.files"
            }
          },
          "guard": "args.repo == inputs.repo && args.branch == 'azhi/' + nodes.intake.output.key"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "open_pr",
        "type": "tool",
        "deps": [
          "build",
          "code_review",
          "intake",
          "push_branch"
        ],
        "dataDeps": [
          "build",
          "code_review",
          "intake",
          "push_branch"
        ],
        "def": {
          "id": "open_pr",
          "type": "tool",
          "description": "Open a pull request for the branch (or return the one already open for it).",
          "tool": "github.create-pull-request@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "head": {
              "ref": "nodes.push_branch.output.branch"
            },
            "base": {
              "cel": "has(inputs.base_branch) ? inputs.base_branch : ''"
            },
            "title": {
              "ref": "nodes.build.output.pr_title"
            },
            "body": {
              "cel": "nodes.build.output.pr_body + '\\n\\n## Validation\\n- Tests: ' + nodes.build.output.workspace.tests.status + ' (' + nodes.build.output.workspace.tests.command + ', attempt ' + string(nodes.build.output.workspace.tests.attempts) + ')\\n- Agent review: ' + nodes.code_review.output.summary + '\\n\\nTicket: ' + nodes.intake.output.key + ' ' + nodes.intake.output.url + '\\n\\n_Opened by Azhi Flow after a person approved this change._'"
            },
            "draft": false
          },
          "guard": "args.repo == inputs.repo && args.head == nodes.push_branch.output.branch"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "release",
        "type": "notify",
        "deps": [
          "build",
          "intake",
          "open_pr"
        ],
        "dataDeps": [
          "build",
          "intake",
          "open_pr"
        ],
        "def": {
          "id": "release",
          "type": "notify",
          "description": "Announce the pull request.",
          "channel": "slack",
          "destination": {
            "ref": "config.channel"
          },
          "message": {
            "cel": "'Pull request for ' + nodes.intake.output.key + ': ' + nodes.open_pr.output.url + ' (' + nodes.build.output.summary + ')'"
          },
          "guard": "args.channel == config.channel"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "action_id": {
              "type": "string"
            },
            "delivered": {
              "type": "boolean"
            },
            "receipt": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "send_back",
        "type": "notify",
        "deps": [
          "build",
          "code_review",
          "intake",
          "quality_gate"
        ],
        "dataDeps": [
          "build",
          "code_review",
          "intake"
        ],
        "def": {
          "id": "send_back",
          "type": "notify",
          "description": "Send the change back with the reasons.",
          "channel": "slack",
          "destination": {
            "ref": "config.channel"
          },
          "message": {
            "cel": "nodes.intake.output.key + ' needs more work (tests ' + nodes.build.output.workspace.tests.status + ', ' + string(nodes.build.output.workspace.stats.files) + ' file(s) changed): ' + nodes.code_review.output.summary"
          },
          "guard": "args.channel == config.channel"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "action_id": {
              "type": "string"
            },
            "delivered": {
              "type": "boolean"
            },
            "receipt": {
              "type": "object"
            }
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "quality_gate",
          "route": "fix"
        }
      },
      {
        "id": "retro",
        "type": "report",
        "deps": [
          "build",
          "code_review",
          "design",
          "intake",
          "open_pr",
          "push_branch",
          "release",
          "requirements"
        ],
        "dataDeps": [
          "build",
          "code_review",
          "design",
          "intake",
          "open_pr",
          "push_branch",
          "requirements"
        ],
        "def": {
          "id": "retro",
          "type": "report",
          "description": "Write the delivery record and retro notes (planned vs actual).",
          "depends_on": [
            "release"
          ],
          "template": "templates/retro.md",
          "input": {
            "map": "{'ticket': nodes.intake.output, 'requirements': nodes.requirements.output, 'design': nodes.design.output, 'change': {'summary': nodes.build.output.summary, 'deviations': nodes.build.output.deviations, 'tests_added': nodes.build.output.tests_added, 'stats': nodes.build.output.workspace.stats, 'tests': nodes.build.output.workspace.tests}, 'review': nodes.code_review.output, 'branch': nodes.push_branch.output, 'pr': nodes.open_pr.output}"
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "as_of": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "markdown",
            "summary"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      }
    ],
    "taint": {
      "untrusted": {
        "requirements": "output of tainted agent requirements",
        "design": "output of tainted agent design",
        "build": "output of tainted agent build",
        "code_review": "output of tainted agent code_review",
        "quality_gate": "output of tainted agent build",
        "push_branch": "output of tainted agent build",
        "open_pr": "output of tainted agent build",
        "release": "output of tainted agent build",
        "send_back": "output of tainted agent build",
        "retro": "output of tainted agent build"
      },
      "tainted": {
        "requirements": "reads a cloned repository (its files are untrusted)",
        "design": "reads a cloned repository (its files are untrusted)",
