            "…",
            "release"
          ],
          "gate": "approval"
        },
        {
          "agent": "design",
          "write": "send_back",
          "path": [
            "design",
            "…",
            "design_review",
            "…",
            "send_back"
          ],
          "gate": "approval"
        },
        {
          "agent": "design",
          "write": "release",
          "path": [
            "design",
            "…",
            "design_review",
            "…",
            "release"
          ],
          "gate": "approval"
        },
        {
          "agent": "build",
          "write": "release",
          "path": [
            "build",
            "release"
          ],
          "gate": "guard"
        },
        {
