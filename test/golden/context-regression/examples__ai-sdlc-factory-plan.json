          "type": "condition",
          "description": "Is there a first epic to split?",
          "expression": "nodes.epics.output.count >= 1 ? 'yes' : 'no'",
          "routes": {
            "yes": [
              "tracker_1"
            ],
            "no": []
          },
          "default": "no"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
