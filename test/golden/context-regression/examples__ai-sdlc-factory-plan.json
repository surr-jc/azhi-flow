        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3,
        "route": {
          "condition": "has_1",
          "route": "yes"
        }
      },
      {
        "id": "split_1_github",
        "type": "subworkflow",
