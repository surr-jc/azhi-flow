        "def": {
          "id": "has_work",
          "type": "condition",
          "description": "Something to deliver, or nothing workable.",
          "expression": "nodes.pick.output.route",
          "routes": {
            "work": [
              "claim_source"
            ],
            "idle": [
              "idle_report"
            ]
          },
          "default": "idle"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "idle_report",
        "type": "report",
        "deps": [
