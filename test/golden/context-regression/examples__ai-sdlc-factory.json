        "def": {
          "id": "idle_report",
          "type": "report",
          "description": "Nothing is workable. No message is sent, so an empty queue is quiet.",
          "template": "templates/idle.md",
          "input": {
            "map": "{'repo': inputs.repo, 'pick': nodes.pick.output}"
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "as_of": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "markdown",
            "summary"
          ]
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "has_work",
          "route": "idle"
        }
      },
      {
        "id": "claim_source",
        "type": "condition",
        "deps": [
          "has_work"
        ],
        "dataDeps": [],
        "def": {
          "id": "claim_source",
          "type": "condition",
          "description": "Claim the ticket in its tracker.",
          "expression": "inputs.source",
          "routes": {
            "github": [
              "claim_github"
            ],
            "jira": [
              "claim_jira"
            ]
          },
          "default": "github"
