          "input": {
            "map": "{'source': inputs.source, 'repo': inputs.repo, 'config': {'claim_label': config.claim_label, 'owner_label': config.owner_label, 'priority_label': config.priority_label}, 'github': {'queues': has(nodes.queue_ready) ? [nodes.queue_ready.output, nodes.queue_split.output] : []}, 'jira': {'issues': has(nodes.queue_jira) && has(nodes.queue_jira.output.issues) ? nodes.queue_jira.output.issues : null}}"
          },
          "output_schema": "schemas/pick.json",
          "limits": {
            "time": "1m"
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3
      },
      {
        "id": "has_work",
        "type": "condition",
        "deps": [
          "pick"
        ],
        "dataDeps": [
          "pick"
