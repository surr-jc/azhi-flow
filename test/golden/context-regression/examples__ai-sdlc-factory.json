  "plan": {
    "format": "azhi-plan/1",
    "compiler": "0.1.0",
    "workflowId": "ai-sdlc-factory",
    "definitionHash": "sha256:23561a80053d8f7e1b2afaf274cfe6a1617bd99a5652773ba3ba3d486ab5f819",
    "inputsSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "title": "Tracker",
          "enum": [
            "github",
            "jira"
          ],
          "description": "Where the tickets live. The code and pull requests are always on GitHub."
        },
        "repo": {
          "type": "string",
          "title": "Repository",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "The GitHub repository to change, owner/name"
        },
        "staging_branch": {
          "type": "string",
          "title": "Staging branch",
          "minLength": 1,
          "maxLength": 200,
          "description": "The branch pull requests are opened against (for example dev). A person merges them there."
        }
      },
      "required": [
        "source",
        "repo",
        "staging_branch"
      ]
    },
    "config": {
      "channel": "{{slack_channel}}",
      "jira_jql": "{{jira_jql}}",
      "ready_label": "ready",
      "split_label": "azhi-split",
      "claim_label": "factory-in-progress",
      "owner_label": "factory-needs-owner",
      "priority_label": "priority"
    },
    "trigger": {
      "manual": true
    },
    "nodes": [
      {
        "id": "source",
        "type": "condition",
        "deps": [],
        "dataDeps": [],
        "def": {
          "id": "source",
          "type": "condition",
          "description": "Read the queue from GitHub or from Jira.",
          "expression": "inputs.source",
          "routes": {
            "github": [
              "queue_ready",
              "queue_split"
            ],
            "jira": [
              "queue_jira"
            ]
          },
          "default": "github"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 1000,
        "maxAttempts": 3
      },
      {
        "id": "queue_ready",
        "type": "tool",
        "deps": [
          "source"
        ],
        "dataDeps": [],
        "def": {
          "id": "queue_ready",
          "type": "tool",
          "description": "Open issues labelled ready (independent tickets, and slices with nothing to wait for).",
          "tool": "github.factory-queue@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "label": {
              "ref": "config.ready_label"
            },
            "claim_label": {
              "ref": "config.claim_label"
            },
            "max_items": 50
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "source",
          "route": "github"
        }
      },
      {
        "id": "queue_split",
        "type": "tool",
        "deps": [
          "source"
        ],
        "dataDeps": [],
        "def": {
          "id": "queue_split",
          "type": "tool",
          "description": "Open issues labelled azhi-split (every slice, including those waiting for an earlier slice).",
          "tool": "github.factory-queue@1",
          "arguments": {
            "repo": {
              "ref": "inputs.repo"
            },
            "label": {
              "ref": "config.split_label"
            },
            "claim_label": {
              "ref": "config.claim_label"
            },
            "max_items": 50
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "source",
          "route": "github"
        }
      },
      {
        "id": "queue_jira",
        "type": "tool",
        "deps": [
          "source"
        ],
        "dataDeps": [],
        "def": {
          "id": "queue_jira",
          "type": "tool",
          "description": "The Jira issues matching the configured JQL (read-only). The JQL must also return recently done issues, so a dependency's status can be read.",
          "tool": "jira.search@1",
          "arguments": {
            "jql": {
              "ref": "config.jira_jql"
            },
            "fields": "summary,status,priority,labels,issuelinks,parent,description,created",
            "limit": 50
          }
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "source",
          "route": "jira"
        }
      },
      {
        "id": "pick",
        "type": "script",
        "deps": [
          "queue_jira",
          "queue_ready",
          "queue_split",
          "source"
