        "dataDeps": [
          "queue_jira",
          "queue_ready",
          "queue_split"
        ],
        "def": {
          "id": "pick",
          "type": "script",
          "description": "Choose the ticket for this lap, by rules, and say why every other one was skipped. Anything unreadable counts as blocking.",
