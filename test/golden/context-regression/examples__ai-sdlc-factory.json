          "guard": "args.repo == inputs.repo && args.number == nodes.pick.output.ticket.number && args.labels == nodes.pick.output.claim_labels"
        },
        "timeoutMs": 60000,
        "maxAttempts": 3,
        "route": {
          "condition": "claim_source",
