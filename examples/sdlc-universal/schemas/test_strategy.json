{
  "type": "object",
  "properties": {
    "failure_class": {
      "enum": [
        "native_binding",
        "toolchain_missing",
        "missing_service",
        "missing_browser",
        "missing_credentials",
        "dependency_install",
        "compile_error",
        "timeout",
        "no_tests",
        "genuine_failures",
        "unknown"
      ]
    },
    "evidence": {
      "type": "string",
      "maxLength": 400,
      "description": "The line from the output that shows the cause"
    },
    "recommended": {
      "enum": [
        "full",
        "static_checks",
        "none"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "covers": {
      "type": "string",
      "maxLength": 400,
      "description": "What the recommended fallback proves"
    },
    "does_not_cover": {
      "type": "string",
      "maxLength": 400,
      "description": "What it does not prove"
    },
    "blocked_suites": {
      "type": "string",
      "maxLength": 80,
      "description": "A count, or unknown"
    },
    "runnable_suites": {
      "type": "string",
      "maxLength": 80,
      "description": "A count, or unknown"
    },
    "basis": {
      "type": "string",
      "maxLength": 300,
      "description": "How the suites were counted"
    },
    "remediation": {
      "type": "string",
      "maxLength": 500
    },
    "ecosystem": {
      "type": "string",
      "maxLength": 200,
      "description": "The language(s) and build tool(s) found, for example java/maven + typescript/pnpm, or unknown"
    }
  },
  "required": [
    "failure_class",
    "ecosystem",
    "evidence",
    "recommended",
    "reason",
    "covers",
    "does_not_cover",
    "blocked_suites",
    "runnable_suites",
    "basis",
    "remediation"
  ],
  "additionalProperties": false
}
