{
  "type": "object",
  "description": "The ticket of a Story without a tracker: the nine fields ticket.normalize returns.",
  "properties": {
    "source": {"const": "files"},
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,60}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "minLength": 1, "maxLength": 20000},
    "priority": {"type": "string"},
    "reporter": {"type": "string"},
    "status": {"type": "string"},
    "labels": {"type": "array", "maxItems": 50, "items": {"type": "string"}},
    "url": {"type": "string"}
  },
  "required": ["source", "key", "title", "description", "priority", "reporter", "status", "labels", "url"],
  "additionalProperties": false
}
