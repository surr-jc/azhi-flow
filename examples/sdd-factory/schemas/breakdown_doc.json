{
  "type": "object",
  "description": "The files the first Story's pull request carries besides its own change: the breakdown, when there is no tracker.",
  "properties": {
    "files": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "pattern": "^docs/release/[a-z0-9][a-z0-9-]{0,60}/[A-Za-z0-9._-]{1,80}\\.md$"},
          "content": {"type": "string", "minLength": 1, "maxLength": 60000}
        },
        "required": ["path", "content"],
        "additionalProperties": false
      }
    }
  },
  "required": ["files"],
  "additionalProperties": false
}
