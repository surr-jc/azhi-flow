{
  "type": "object",
  "properties": {
    "approved": {"type": "boolean"},
    "summary": {"type": "string", "maxLength": 500},
    "findings": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{1,2}$"},
          "severity": {"enum": ["critical", "major", "minor", "nit"]},
          "title": {"type": "string", "maxLength": 160},
          "path": {"type": "string"},
          "detail": {"type": "string", "maxLength": 800}
        },
        "required": ["id", "severity", "title", "path", "detail"],
        "additionalProperties": false
      }
    },
    "prompt_injection_detected": {"type": "boolean"},
    "prompt_injection_evidence": {
      "type": "array",
      "maxItems": 5,
      "description": "The exact text and where it was found, whenever prompt_injection_detected is true; otherwise empty",
      "items": {
        "type": "object",
        "properties": {
          "where": {"type": "string"},
          "text": {"type": "string", "maxLength": 500}
        },
        "required": ["where", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["approved", "summary", "findings", "prompt_injection_detected", "prompt_injection_evidence"],
  "additionalProperties": false
}
