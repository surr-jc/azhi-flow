{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "problem": {
      "type": "string",
      "description": "Who has what problem and what it costs, without naming the solution"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "research": {
            "type": "string",
            "description": "What the repository and comparable systems do (path:line for the repository)"
          },
          "options": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "pros": {
                  "type": "string"
                },
                "cons": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "pros",
                "cons"
              ],
              "additionalProperties": false
            }
          },
          "recommended_default": {
            "type": "string"
          },
          "counter_argument": {
            "type": "string",
            "description": "The strongest objection to the recommendation, and why it still wins"
          },
          "why": {
            "type": "string",
            "description": "The concrete cost of getting it wrong"
          }
        },
        "required": [
          "question",
          "recommended_default"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "problem",
    "acceptance_criteria",
    "non_goals",
    "evidence",
    "open_questions"
  ],
  "additionalProperties": false
}
