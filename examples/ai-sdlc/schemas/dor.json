{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "enum": [
              "testable_criteria",
              "no_placeholders",
              "no_bare_references",
              "one_pr_scope",
              "specific_surface",
              "done_state",
              "stated_assumptions"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "finding": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "description": "On a fail: the one question that would make it pass"
          }
        },
        "required": [
          "gate",
          "status",
          "confidence",
          "finding"
        ],
        "additionalProperties": false
      }
    },
    "dispatchable": {
      "type": "boolean",
      "description": "As written, deliverable as one code change in this repository; false stops the run"
    },
    "dispatch_reason": {
      "type": "string"
    }
  },
  "required": [
    "summary",
    "gates",
    "dispatchable"
  ],
  "additionalProperties": false
}
