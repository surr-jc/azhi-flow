{
  "type": "object",
  "properties": {
    "title": {"type": "string", "maxLength": 120},
    "summary": {"type": "string", "maxLength": 600},
    "problem": {"type": "string", "maxLength": 3000},
    "owner": {
      "type": "object",
      "properties": {
        "value": {"type": ["string", "null"], "maxLength": 200},
        "evidence": {"type": "string", "maxLength": 400}
      },
      "required": ["value", "evidence"],
      "additionalProperties": false
    },
    "goals": {"type": "array", "items": {"type": "string", "maxLength": 400}, "minItems": 1, "maxItems": 12},
    "non_goals": {"type": "array", "items": {"type": "string", "maxLength": 400}, "maxItems": 12},
    "invariants": {"type": "array", "items": {"type": "string", "maxLength": 400}, "maxItems": 12},
    "journeys": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "maxLength": 120},
          "steps": {"type": "array", "items": {"type": "string", "maxLength": 300}, "minItems": 1, "maxItems": 12}
        },
        "required": ["name", "steps"],
        "additionalProperties": false
      }
    },
    "risks": {"type": "array", "items": {"type": "string", "maxLength": 400}, "maxItems": 12},
    "open_questions": {"type": "array", "items": {"type": "string", "maxLength": 400}, "maxItems": 12},
    "walking_skeleton": {"type": "string", "maxLength": 600},
    "epics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "maxLength": 120},
          "goal": {"type": "string", "maxLength": 1200},
          "scope": {"type": "array", "items": {"type": "string", "maxLength": 400}, "minItems": 1, "maxItems": 12},
          "acceptance_criteria": {"type": "array", "items": {"type": "string", "maxLength": 400}, "minItems": 1, "maxItems": 12},
          "depends_on_note": {"type": "string", "maxLength": 400}
        },
        "required": ["title", "goal", "scope", "acceptance_criteria", "depends_on_note"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "summary", "problem", "owner", "goals", "non_goals", "invariants", "journeys", "risks", "open_questions", "walking_skeleton", "epics"],
  "additionalProperties": false
}
