{
  "type": "object",
  "description": "Requirements and design from one grounded pass over the repository.",
  "properties": {
    "requirements": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 300
        },
        "problem": {
          "type": "string",
          "description": "Who has what problem and what it costs, without naming the solution"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "open_questions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "research": {
                "type": "string",
                "description": "What the repository and comparable systems do (path:line for the repository)"
              },
              "options": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "pros": {
                      "type": "string"
                    },
                    "cons": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "pros",
                    "cons"
                  ],
                  "additionalProperties": false
                }
              },
              "recommended_default": {
                "type": "string"
              },
              "counter_argument": {
                "type": "string",
                "description": "The strongest objection to the recommendation, and why it still wins"
              },
              "why": {
                "type": "string",
                "description": "The concrete cost of getting it wrong"
              },
              "criterion": {
                "type": "integer",
                "minimum": 0,
                "description": "The acceptance criterion this question decides, numbered from 1 (0 when it decides none)"
              }
            },
            "required": [
              "question",
              "recommended_default"
            ],
            "additionalProperties": false
          }
        },
        "criteria_source": {
          "enum": [
            "ticket",
            "derived",
            "mixed"
          ],
          "description": "ticket: every criterion was stated in the ticket or its linked page. derived: the ticket stated none and you wrote them from the request. mixed: some stated, some added to cover what the request implies"
        }
      },
      "required": [
        "summary",
        "problem",
        "acceptance_criteria",
        "non_goals",
        "evidence",
        "open_questions",
        "criteria_source"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 300
        },
        "approaches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "tradeoffs": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "tradeoffs"
            ],
            "additionalProperties": false
          }
        },
        "recommended": {
          "type": "string",
          "description": "The chosen approach and why"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "create",
                  "update",
                  "delete"
                ]
              },
              "change": {
                "type": "string"
              },
              "pattern": {
                "type": "string",
                "description": "file:line of the existing code to mirror"
              }
            },
            "required": [
              "path",
              "action",
              "change"
            ],
            "additionalProperties": false
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "CREATE",
                  "UPDATE",
                  "ADD",
                  "REMOVE",
                  "REFACTOR",
                  "MIRROR"
                ]
              },
              "target": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "gotcha": {
                "type": "string"
              },
              "satisfies": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "target",
              "detail",
              "satisfies"
            ],
            "additionalProperties": false
          }
        },
        "test_plan": {
          "type": "string"
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "risk": {
                "type": "string"
              },
              "mitigation": {
                "type": "string"
              }
            },
            "required": [
              "risk",
              "mitigation"
            ],
            "additionalProperties": false
          }
        },
        "open_questions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "research": {
                "type": "string",
                "description": "What the repository and comparable systems do (path:line for the repository)"
              },
              "options": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "pros": {
                      "type": "string"
                    },
                    "cons": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "pros",
                    "cons"
                  ],
                  "additionalProperties": false
                }
              },
              "recommended_default": {
                "type": "string"
              },
              "counter_argument": {
                "type": "string",
                "description": "The strongest objection to the recommendation, and why it still wins"
              },
              "why": {
                "type": "string",
                "description": "The concrete cost of getting it wrong"
              },
              "criterion": {
                "type": "integer",
                "minimum": 0,
                "description": "The acceptance criterion this question decides, numbered from 1 (0 when it decides none)"
              }
            },
            "required": [
              "question",
              "recommended_default"
            ],
            "additionalProperties": false
          }
        },
        "confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "How likely a one-pass implementation is"
        },
        "touches_sensitive": {
          "type": "boolean",
          "description": "A planned file is auth, payments, secrets, a migration or schema, CI or governance config, or a public contract"
        },
        "has_migration": {
          "type": "boolean"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The files or behaviours behind the rating"
        },
        "ac_verification": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per acceptance criterion, in order: how the change will be shown to meet it",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "integer",
                "minimum": 1,
                "description": "The criterion number, 1 for the first"
              },
              "how": {
                "enum": [
                  "automated_test",
                  "static_check",
                  "manual"
                ]
              },
              "where": {
                "type": "string",
                "description": "automated_test: the test file and name to add or extend. static_check: the compile, type or lint step that would catch a violation. manual: what a person must look at, and why it cannot be automated"
              }
            },
            "required": [
              "criterion",
              "how",
              "where"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "summary",
        "approaches",
        "recommended",
        "files",
        "tasks",
        "test_plan",
        "risks",
        "open_questions",
        "confidence",
        "touches_sensitive",
        "has_migration",
        "risk",
        "risk_reasons",
        "ac_verification"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requirements",
    "design"
  ],
  "additionalProperties": false
}