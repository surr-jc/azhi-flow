{
  "type": "object",
  "properties": {
    "summary": {"type": "string", "maxLength": 600},
    "scenarios": {
      "description": "One entry per scenario in the input, same ids.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^P[1-5]$"},
          "mode": {"enum": ["executed", "static"]},
          "static_result": {"enum": ["ruled_out", "unproven", "none"], "description": "For mode static; none for an executed probe"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Static: the walked path with file:line, or the runtime evidence it needs. Executed: what the probe asserts."}
        },
        "required": ["id", "mode", "static_result", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["summary", "scenarios"],
  "additionalProperties": false
}
