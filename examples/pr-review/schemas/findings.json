{
  "type": "object",
  "properties": {
    "reviewer": {"type": "string"},
    "summary": {"type": "string", "maxLength": 1000, "description": "Two or three plain sentences, at most 1000 characters. Put detail in findings, not here."},
    "findings": {
      "description": "Always include this field; use [] when there is nothing to report.",
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "maxLength": 120},
          "detail": {"type": "string", "maxLength": 1000}
        },
        "required": ["severity", "path", "title", "detail"],
        "additionalProperties": false
      }
    }
  },
  "required": ["reviewer", "summary", "findings"],
  "additionalProperties": false
}
