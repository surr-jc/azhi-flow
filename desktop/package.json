{
  "name": "azhi-flow-desktop",
  "version": "0.1.0-beta.1",
  "description": "Azhi Flow desktop app: a window, tray and notifications around the local backend.",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main.js",
